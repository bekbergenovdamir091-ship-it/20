
<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Puzzle O'yini</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #141e30, #243b55);
    color: white;
    text-align: center;
    min-height: 100vh;
    padding: 25px 10px;
}

h1 {
    color: #ffd700;
    font-size: 35px;
}

.info {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin: 20px;
    font-size: 18px;
}

#puzzle {
    width: min(90vw, 390px);
    height: min(90vw, 390px);
    margin: 20px auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 4px;
    background: white;
    padding: 4px;
    border-radius: 12px;
}

.tile {
    background-image: url("https://picsum.photos/id/237/600/600");
    background-size: 300% 300%;
    border-radius: 5px;
    cursor: grab;
    transition: 0.2s;
}

.tile:hover {
    filter: brightness(1.2);
}

.tile:active {
    cursor: grabbing;
}

.empty {
    background: #243b55;
    border: 2px dashed #ffd700;
}

button {
    padding: 12px 25px;
    background: #ffd700;
    color: #222;
    border: none;
    border-radius: 8px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    margin: 10px;
}

button:hover {
    background: orange;
}

#message {
    font-size: 22px;
    color: #00ff99;
    font-weight: bold;
    margin-top: 15px;
}
</style>
</head>

<body>

<h1>🧩 Puzzle O'yini</h1>

<div class="info">
    <div>⏱ Vaqt: <span id="time">0</span>s</div>
    <div>👣 Yurish: <span id="moves">0</span></div>
</div>

<div id="puzzle"></div>

<button onclick="shuffle()">🔄 Qayta boshlash</button>

<div id="message"></div>

<script>
const puzzle = document.getElementById("puzzle");

let tiles = [];
let moves = 0;
let seconds = 0;
let timer = null;
let started = false;

function draw() {
    puzzle.innerHTML = "";

    tiles.forEach((number, index) => {
        const tile = document.createElement("div");

        tile.className = number === 0
            ? "tile empty"
            : "tile";

        if (number !== 0) {
            let row = Math.floor((number - 1) / 3);
            let col = (number - 1) % 3;

            tile.style.backgroundPosition =
                `${col * 50}% ${row * 50}%`;
        }

        tile.addEventListener("click", () => move(index));

        puzzle.appendChild(tile);
    });
}

function move(index) {
    const empty = tiles.indexOf(0);

    const row = Math.floor(index / 3);
    const col = index % 3;

    const emptyRow = Math.floor(empty / 3);
    const emptyCol = empty % 3;

    if (
        Math.abs(row - emptyRow) +
        Math.abs(col - emptyCol) === 1
    ) {
        if (!started) startTimer();

        [tiles[index], tiles[empty]] =
        [tiles[empty], tiles[index]];

        moves++;
        document.getElementById("moves").textContent = moves;

        draw();
        checkWin();
    }
}

function startTimer() {
    started = true;

    timer = setInterval(() => {
        seconds++;
        document.getElementById("time").textContent = seconds;
    }, 1000);
}

function shuffle() {
    clearInterval(timer);

    tiles = [1,2,3,4,5,6,7,8,0];

    // Tasodifiy, lekin yechiladigan holat
    for (let i = 0; i < 200; i++) {
        const empty = tiles.indexOf(0);
        const neighbors = [];

        if (empty % 3 !== 0) neighbors.push(empty - 1);
        if (empty % 3 !== 2) neighbors.push(empty + 1);
        if (empty >= 3) neighbors.push(empty - 3);
        if (empty < 6) neighbors.push(empty + 3);

        const random = neighbors[
            Math.floor(Math.random() * neighbors.length)
        ];

        [tiles[empty], tiles[random]] =
        [tiles[random], tiles[empty]];
    }

    moves = 0;
    seconds = 0;
    started = false;

    document.getElementById("moves").textContent = 0;
    document.getElementById("time").textContent = 0;
    document.getElementById("message").textContent = "";

    draw();
}

function checkWin() {
    if (tiles.join(",") === "1,2,3,4,5,6,7,8,0") {
        clearInterval(timer);

        document.getElementById("message").textContent =
            "🎉 Tabriklayman! Sen g'olib bo'lding!";
    }
}

shuffle();
</script>

</body>
</html>
